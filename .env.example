
# Puerto del servidor HTTP
PORT=3001

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/peerly-auth

# JWT — DEBE ser idéntico al JWT_SECRET de peerly-realtime-management
# Si los valores no coinciden, la verificación de tokens en realtime fallará con AUTH_ERROR
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=1h
